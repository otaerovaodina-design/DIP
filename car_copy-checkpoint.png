    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Image loaded successfully\n"
     ]
    }
   ],
   "source": [
    "\n",
    "img = cv2.imread(\"CAU.png\")\n",
    "\n",
    "if img is None:\n",
    "    print(\"Upload an image named sample.jpg\")\n",
    "else:\n",
    "    print(\"Image loaded successfully\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c9ce335a9d788521",
