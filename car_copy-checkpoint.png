   ],
   "source": [
    "plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n",
    "plt.axis(\"off\")\n",
    "\n",
    "\n",
    "print(\"Shape (H, W, C):\", img.shape)\n",
    "print(\"Height:\", img.shape[0])\n",
    "print(\"Width:\", img.shape[1])\n",
    "print(\"Channels:\", img.shape[2])\n",
    "print(\"Data type:\", img.dtype)\n",
    "print(\"Total pixels:\", img.size)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "80bc86fcb55a18ed",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-01-28T07:06:03.457403Z",
