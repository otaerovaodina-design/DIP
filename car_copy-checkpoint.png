   ],
   "source": [
    "grayscale_image = cv2.imread('car_copy.png', cv2.IMREAD_GRAYSCALE)\n",
    "plt.imshow(grayscale_image)\n",
    "cv2.imwrite(\"car_grayscale.png\", grayscale_image)"
   ]
  },
