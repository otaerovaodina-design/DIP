   ],
   "source": [
    "img_copy = img.copy()\n",
    "draw = img_copy\n",
    "\n",
    "cv2.rectangle(draw, (100,100), (600,600), (0,0,255), 3)\n",
    "cv2.imwrite(\"car_copy.png\", img_copy)\n",
    "plt.imshow(cv2.cvtColor(img_copy, cv2.COLOR_BGR2RGB))\n",
    "plt.title(\"Copied Image (Modified!)\")"
   ]
  },
